# =============================================================================
# Sprena — .gitignore
# =============================================================================

# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.iws
*.ipr
.fleet/
.vscode/

# --- Android ---
local.properties
google-services.json
*.apk
*.aab
*.ap_
*.dex
captures/
# Saida de `assembleRelease` (APK + baseline profiles + metadata)
composeApp/release/

# --- Kotlin ---
*.class
.kotlin/

# --- Static Analysis ---
# Configs and baselines are versioned. Only ignore generated reports.
**/build/reports/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Docker ---
# Keep Dockerfile and docker-compose.yml tracked
# Ignore any local override files
docker-compose.override.yml

# --- Firebase ---
# firebase.json e firestore.rules sao versionados. O .firebaserc amarra o repo
# a um projeto real (mesma postura do google-services.json) — fica local.
.firebaserc
firebase-debug.log
firestore-debug.log
node_modules/

# --- Docs locais / segredos ---
# Runbooks e anotações com dado real (usuários de teste, UIDs, senhas).
# O processo genérico fica em docs/ops/*.md (versionado); o dado, em *.local.*
*.local.md
*.local.json
docs/ops/*.local.*
