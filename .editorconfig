root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_filename = enabled
# Compose convention: allow PascalCase names for @Composable functions
ktlint_function_naming_ignore_when_annotated_with = Composable

# F1.5: código gerado (ex.: Res.kt e os coletores de recursos do Compose
# Resources em composeApp/build/generated/...) não é código autoral e não deve
# ser formatado por ktlint. A exclusão via `ktlint { filter { exclude(...) } }`
# no build.gradle.kts não alcança esses arquivos: o próprio diretório gerado é a
# raiz da árvore de origem que o plugin do ktlint enxerga, então padrões
# relativos como "**/build/**" nunca casam. Desabilitar via editorconfig, que o
# motor do ktlint consulta por arquivo, é a forma que realmente funciona.
[**/build/**/*.kt]
ktlint = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
