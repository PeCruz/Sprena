root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

# ktlint — allow PascalCase names for @Composable functions (Compose convention)
ktlint_function_naming_ignore_when_annotated_with = Composable
