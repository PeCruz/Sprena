{
  "name": "sprena-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Testes das Firestore Security Rules do Sprena, rodados contra o emulador.",
  "scripts": {
    "test": "node --test",
    "test:emulator": "firebase --config ../../firebase.json emulators:exec --only firestore --project demo-sprena \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.1.0",
    "firebase-tools": "^15.26.0"
  }
}
