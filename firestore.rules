rules_version = '2';

// =============================================================================
// Sprena — Firestore Security Rules (F1.4)
//
// Deploy: firebase deploy --only firestore:rules --project <projeto>
// Testes: cd tools/firestore-rules-tests && npm run test:emulator
//
// Estas regras sao a unica barreira server-side. O RBAC no app (F2,
// RoleGuardedUseCase) e conveniencia de UX — quem chamar a API do Firestore
// direto passa por aqui, nao pelo app.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Doc de perfil do requisitante, ou null se ele nao tiver um.
    // Custa 1 document access por request que invoca — trade-off aceito em
    // SECURITY.md (role no Firestore em vez de Custom Claims).
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // `&&` faz curto-circuito: sem login nao chama get(), e sem doc nao le .data
    // (acessar .data de null e evaluation error, que negaria por acidente).
    //
    // NOTA: em request NEGADO que passa por aqui, o emulador loga
    // "evaluation error at L<n>" seguido de "false" na mesma linha. E o motor
    // avaliando antes de resolver o get() e reavaliando depois — a decisao que
    // vale e a segunda. Nao e bug da regra: escrita de ADM/MOD passa (ver
    // casos 8a/8b em tools/firestore-rules-tests/rules.test.mjs).
    function isStaff() {
      return isSignedIn()
        && profile() != null
        && profile().data.role in ['ADM', 'MOD'];
    }

    // Perfil do usuario — lido no login para resolver a role
    // (FirebaseAuthRepositoryImpl.authenticate).
    //
    // Escrita bloqueada para todo mundo: usuarios sao provisionados pelo Console
    // ou Admin SDK (docs/ops/firebase-users-runbook.md). Sem isso, qualquer
    // usuario logado poderia se auto-promover a ADM.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Clientes esportivos — contem PII (CPF, telefone).
    // Leitura para qualquer autenticado; escrita so ADM/MOD.
    match /sport_clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // Aceite da politica de privacidade (F1.5).
    //
    // O id do doc e o uid DE PROPOSITO: a regra de leitura e baseada no path, nao
    // em resource.data. Uma regra que lesse resource.data.uid daria evaluation
    // error num doc inexistente, e o app nao conseguiria distinguir "nunca aceitou"
    // de "sem permissao" — o gate precisa dessa diferenca.
    //
    // A subcolecao history e append-only: e ela que sustenta o onus da prova do
    // consentimento (LGPD art. 8 §1) quando a politica ganha versao nova e o doc
    // corrente e sobrescrito.
    //
    // O id do doc de historico e automatico, NAO a versao da politica. Com o id
    // igual a versao, reaceitar a mesma versao seria `set` sobre doc existente —
    // que aqui conta como `update` e e negado, derrubando o batch inteiro e
    // prendendo o usuario no gate fail-closed. Cada aceite e uma insercao nova; a
    // versao vai no campo `policyVersion`, validado como string nao vazia.
    match /user_consents/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.policyVersion is string
        && request.resource.data.policyVersion.size() > 0
        && request.resource.data.acceptedAt == request.time;
      allow delete: if false;

      match /history/{acceptanceId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.policyVersion is string
          && request.resource.data.policyVersion.size() > 0
          && request.resource.data.acceptedAt == request.time;
        allow update, delete: if false;
      }
    }

    // Perfil autodeclarado do titular (F1.6a).
    //
    // Colecao separada de `users/{uid}` DE PROPOSITO. La vive a role, e a rule de F1.4
    // nega toda escrita — inclusive do dono — justamente para impedir auto-promocao.
    // Abrir uma excecao la exigiria uma allowlist de chaves, que e correta hoje e vira
    // bug silencioso no dia em que F1.7 adicionar `establishmentIds` (que parece campo de
    // perfil mas e AUTORIZACAO) e alguem o incluir na lista por reflexo. Aqui a palavra
    // `role` nao existe, entao nao ha allowlist a esquecer. Ver SECURITY.md, F1.6a.
    //
    // `create` e permitido — ao contrario de `users` — porque o doc nasce no primeiro
    // save do titular e nao existe para quem nunca editou. Nao ha backfill.
    match /user_profiles/{uid} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == uid;
      }

      // Forma forte (`keys().hasOnly`) em vez de `diff().affectedKeys().hasOnly`: valida
      // o estado final inteiro e se comporta igual em create (onde `resource` e null) e
      // em update. Fecha a porta para o cliente inventar um campo que uma feature futura
      // leia como autorizacao.
      function onlyKnownKeys() {
        return request.resource.data.keys().hasOnly(
          ['apelido', 'cpf', 'phone', 'modalities', 'updatedAt']
        );
      }

      // Todo campo e opcional (ausente = "nao informado", estado legitimo), mas quando
      // presente precisa ter tipo e tamanho sao. `updatedAt == request.time` e
      // anti-backdating, espelhando `acceptedAt` de F1.5.
      function validPayload() {
        return (!('apelido' in request.resource.data)
            || (request.resource.data.apelido is string
                && request.resource.data.apelido.size() <= 60))
          && (!('cpf' in request.resource.data)
            || (request.resource.data.cpf is string
                && request.resource.data.cpf.size() <= 14))
          && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 20))
          && (!('modalities' in request.resource.data)
            || (request.resource.data.modalities is list
                && request.resource.data.modalities.size() <= 10))
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && onlyKnownKeys() && validPayload();
      // A exclusao passa pela Cloud Function (Admin SDK), nunca pelo cliente: apagar so
      // o perfil deixaria a conta viva com os dados sumidos, que nao e o que o titular
      // pediu ao clicar em "excluir conta".
      allow delete: if false;
    }

    // Trilha de exclusoes de conta (F1.6a). Escrita SO pelo Admin SDK dentro da Cloud
    // Function, que nao passa por estas rules. O default deny abaixo ja negaria, mas uma
    // colecao de auditoria merece a negacao escrita a mao — quem ler o arquivo precisa
    // ver que ninguem, nem o ADM, le ou altera a trilha pelo app.
    match /account_deletions/{uid} {
      allow read, write: if false;
    }

    // Default deny. kanban e financial ainda sao in-memory; quando migrarem
    // para o Firestore vao bater aqui ate ganharem o proprio bloco `match`.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
