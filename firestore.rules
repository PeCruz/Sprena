rules_version = '2';

// =============================================================================
// Sprena — Firestore Security Rules (F1.4)
//
// Deploy: firebase deploy --only firestore:rules --project <projeto>
// Testes: cd tools/firestore-rules-tests && npm run test:emulator
//
// Estas regras sao a unica barreira server-side. O RBAC no app (F2,
// RoleGuardedUseCase) e conveniencia de UX — quem chamar a API do Firestore
// direto passa por aqui, nao pelo app.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Doc de perfil do requisitante, ou null se ele nao tiver um.
    // Custa 1 document access por request que invoca — trade-off aceito em
    // SECURITY.md (role no Firestore em vez de Custom Claims).
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // F1.7.1 — multi-tenancy.
    //
    // A role passa a ter DOIS niveis. `users/{uid}.role` guarda o papel global e so
    // responde uma pergunta: e ADM? Os papeis operacionais (MOD, CLIENT, USER) vivem
    // em `establishments/{estId}/members/{uid}.role`, porque "MOD gere os SEUS
    // estabelecimentos" so fecha com papel por tenant — e assim a mesma pessoa pode ser
    // MOD num lugar e CLIENT noutro.
    //
    // `estId` vem SEMPRE do path, nunca de `resource.data`. Isso nao e estilo: numa
    // query o motor avalia a rule por documento, mas guarda o resultado do get() quando
    // a expressao do path e identica. Com o tenant no path, listar N comandas custa 1
    // get; com o tenant num campo, o path muda a cada documento e o cache morre.
    //
    // O `isStaff()` de F1.4 foi removido em F1.7.2 junto com seu unico consumidor, a
    // colecao global `sport_clients`. O papel MOD deixou de ser global, entao a pergunta
    // que ele respondia ("e ADM ou MOD?") nao tem mais resposta sem um estabelecimento.
    // -------------------------------------------------------------------------

    // `&&` faz curto-circuito: sem login nao chama get(), e sem doc nao le .data
    // (acessar .data de null e evaluation error, que negaria por acidente).
    //
    // NOTA, valida para todos os helpers deste bloco: em request NEGADO que passa por
    // aqui, o emulador loga "evaluation error at L<n>" seguido de "false" na mesma linha.
    // E o motor avaliando antes de resolver o get() e reavaliando depois — a decisao que
    // vale e a segunda. Nao e bug da regra: as escritas legitimas passam (ver os casos 6
    // e 8 em tools/firestore-rules-tests/rules.test.mjs).
    function isAdm() {
      return isSignedIn()
        && profile() != null
        && profile().data.role == 'ADM';
    }

    function memberDoc(estId) {
      return get(/databases/$(database)/documents/establishments/$(estId)/members/$(request.auth.uid));
    }

    function isMemberOf(estId) {
      return isSignedIn()
        && memberDoc(estId) != null
        && memberDoc(estId).data.active == true;
    }

    function roleIn(estId) {
      return memberDoc(estId).data.role;
    }

    function isModOf(estId) {
      return isMemberOf(estId) && roleIn(estId) == 'MOD';
    }

    function isStaffOf(estId) {
      return isMemberOf(estId) && roleIn(estId) in ['MOD', 'CLIENT'];
    }

    // Ordem deliberada: membro primeiro. E o caso comum e resolve em 1 get; deixar
    // isAdm() na frente cobraria a leitura de `users` de todo mundo, o tempo todo.
    function canReadTenant(estId) {
      return isMemberOf(estId) || isAdm();
    }

    // Perfil do usuario — lido no login para resolver a role
    // (FirebaseAuthRepositoryImpl.authenticate).
    //
    // Escrita bloqueada para todo mundo: usuarios sao provisionados pelo Console
    // ou Admin SDK (docs/ops/firebase-users-runbook.md). Sem isso, qualquer
    // usuario logado poderia se auto-promover a ADM.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Aceite da politica de privacidade (F1.5).
    //
    // O id do doc e o uid DE PROPOSITO: a regra de leitura e baseada no path, nao
    // em resource.data. Uma regra que lesse resource.data.uid daria evaluation
    // error num doc inexistente, e o app nao conseguiria distinguir "nunca aceitou"
    // de "sem permissao" — o gate precisa dessa diferenca.
    //
    // A subcolecao history e append-only: e ela que sustenta o onus da prova do
    // consentimento (LGPD art. 8 §1) quando a politica ganha versao nova e o doc
    // corrente e sobrescrito.
    //
    // O id do doc de historico e automatico, NAO a versao da politica. Com o id
    // igual a versao, reaceitar a mesma versao seria `set` sobre doc existente —
    // que aqui conta como `update` e e negado, derrubando o batch inteiro e
    // prendendo o usuario no gate fail-closed. Cada aceite e uma insercao nova; a
    // versao vai no campo `policyVersion`, validado como string nao vazia.
    match /user_consents/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.policyVersion is string
        && request.resource.data.policyVersion.size() > 0
        && request.resource.data.acceptedAt == request.time;
      allow delete: if false;

      match /history/{acceptanceId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.policyVersion is string
          && request.resource.data.policyVersion.size() > 0
          && request.resource.data.acceptedAt == request.time;
        allow update, delete: if false;
      }
    }

    // Perfil autodeclarado do titular (F1.6a).
    //
    // Colecao separada de `users/{uid}` DE PROPOSITO. La vive a role, e a rule de F1.4
    // nega toda escrita — inclusive do dono — justamente para impedir auto-promocao.
    // Abrir uma excecao la exigiria uma allowlist de chaves, que e correta hoje e vira
    // bug silencioso no dia em que F1.7 adicionar `establishmentIds` (que parece campo de
    // perfil mas e AUTORIZACAO) e alguem o incluir na lista por reflexo. Aqui a palavra
    // `role` nao existe, entao nao ha allowlist a esquecer. Ver SECURITY.md, F1.6a.
    //
    // `create` e permitido — ao contrario de `users` — porque o doc nasce no primeiro
    // save do titular e nao existe para quem nunca editou. Nao ha backfill.
    match /user_profiles/{uid} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == uid;
      }

      // Forma forte (`keys().hasOnly`) em vez de `diff().affectedKeys().hasOnly`: valida
      // o estado final inteiro e se comporta igual em create (onde `resource` e null) e
      // em update. Fecha a porta para o cliente inventar um campo que uma feature futura
      // leia como autorizacao.
      function onlyKnownKeys() {
        return request.resource.data.keys().hasOnly(
          ['apelido', 'cpf', 'phone', 'modalities', 'updatedAt']
        );
      }

      // Todo campo e opcional (ausente = "nao informado", estado legitimo), mas quando
      // presente precisa ter tipo e tamanho sao. `updatedAt == request.time` e
      // anti-backdating, espelhando `acceptedAt` de F1.5.
      function validPayload() {
        return (!('apelido' in request.resource.data)
            || (request.resource.data.apelido is string
                && request.resource.data.apelido.size() <= 60))
          && (!('cpf' in request.resource.data)
            || (request.resource.data.cpf is string
                && request.resource.data.cpf.size() <= 14))
          && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 20))
          && (!('modalities' in request.resource.data)
            || (request.resource.data.modalities is list
                && request.resource.data.modalities.size() <= 10))
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && onlyKnownKeys() && validPayload();
      // A exclusao passa pela Cloud Function (Admin SDK), nunca pelo cliente: apagar so
      // o perfil deixaria a conta viva com os dados sumidos, que nao e o que o titular
      // pediu ao clicar em "excluir conta".
      allow delete: if false;
    }

    // Trilha de exclusoes de conta (F1.6a). Escrita SO pelo Admin SDK dentro da Cloud
    // Function, que nao passa por estas rules. O default deny abaixo ja negaria, mas uma
    // colecao de auditoria merece a negacao escrita a mao — quem ler o arquivo precisa
    // ver que ninguem, nem o ADM, le ou altera a trilha pelo app.
    match /account_deletions/{uid} {
      allow read, write: if false;
    }

    // Colecoes escritas SO pelo Admin SDK, dentro das callables de vinculo (F1.7.3c).
    // O default deny la embaixo ja negaria as tres; a negacao esta escrita a mao porque
    // colecao de seguranca merece ser legivel como decisao, e nao como consequencia.
    //
    // `cpf_claims` e a trava 1-CPF-por-conta. O id dela E o HMAC do CPF, entao um `get`
    // que distinguisse existente de inexistente viraria oraculo de "este CPF tem conta
    // aqui" — exatamente o que a vinculacao write-only foi desenhada para nao ter.
    match /cpf_claims/{cpfHmac} {
      allow read, write: if false;
    }

    // Nem o proprio dono le: saber quantas tentativas restam ajuda quem esta adivinhando
    // CPF a se manter abaixo do limite.
    match /rate_limits/{uid} {
      allow read, write: if false;
    }

    match /security_events/{eventId} {
      allow read, write: if false;
    }

    // Preferencia de contexto do seletor global de estabelecimento (F1.7.1).
    //
    // Nao pode morar em `users` (toda escrita e negada) nem em `user_profiles` — a
    // allowlist de la e exatamente o reflexo que o comentario acima pede para nao ter.
    // Vive aqui, escrita pelo dono, sustentada por uma invariante que precisa ser
    // preservada por quem editar este arquivo depois:
    //
    //     NENHUMA regra deste arquivo le `user_settings`.
    //
    // E so por causa dela que deixar o cliente escrever aqui e seguro: apontar o
    // contexto para um estabelecimento alheio e permitido e completamente inutil,
    // porque todo acesso continua barrado por isMemberOf(estId) vindo do path.
    match /user_settings/{uid} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == uid;
      }

      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['activeEstablishmentId', 'updatedAt'])
        && (request.resource.data.activeEstablishmentId == null
          || (request.resource.data.activeEstablishmentId is string
            && request.resource.data.activeEstablishmentId.size() <= 64))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Unicidade de CNPJ. O id do doc E o CNPJ, entao `create` sobre id existente falha
    // sozinho — e a unica forma de garantir unicidade sem serializar tudo numa callable.
    //
    // Leitura liberada so para o ADM. Nao vaza nada que ele ja nao veja: `list` em
    // establishments e dele, e o CNPJ esta em texto claro la. E sem esse get o app nao
    // consegue distinguir "CNPJ ja cadastrado" de "sem permissao" — os dois chegariam
    // como PERMISSION_DENIED do mesmo batch, e o ADM veria "erro ao salvar" sem saber que
    // basta procurar o estabelecimento que ja existe.
    match /cnpj_index/{cnpj} {
      allow read: if isAdm();
      allow create: if isAdm() && request.resource.data.establishmentId is string;
      allow update, delete: if false;
    }

    // Estabelecimentos (F1.7.1).
    //
    // `list` e so do ADM. Um membro nao precisa listar a colecao para saber onde
    // trabalha: ele descobre pelo proprio member doc, via collection group logo abaixo.
    // Manter o list fechado evita ter que provar por rule que uma query devolveu apenas
    // os estabelecimentos do requisitante — prova que o motor de rules nao sabe fazer.
    match /establishments/{estId} {
      function onlyKnownKeys() {
        return request.resource.data.keys().hasOnly([
          'name', 'active', 'cnpj', 'razaoSocial', 'address',
          'phone', 'email', 'createdAt', 'updatedAt', 'createdBy'
        ]);
      }

      // Regex e o teto do que rules conseguem fazer com documento: digito verificador
      // de CNPJ exige aritmetica. A validacao real e do CnpjValidator no dominio; aqui
      // fica a barreira de forma, que e o que impede lixo estrutural de entrar.
      function validEstablishment() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.active is bool
          && request.resource.data.cnpj is string
          && request.resource.data.cnpj.matches('^[0-9]{14}$')
          && request.resource.data.phone is string
          && request.resource.data.phone.matches('^[0-9]{10,11}$')
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.email.size() <= 120
          && (!('razaoSocial' in request.resource.data)
            || (request.resource.data.razaoSocial is string
              && request.resource.data.razaoSocial.size() <= 120))
          && (!('address' in request.resource.data)
            || request.resource.data.address is map)
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if canReadTenant(estId);
      allow list: if isAdm();
      allow create, update: if isAdm() && onlyKnownKeys() && validEstablishment();
      // Sem delete: apagar o estabelecimento deixaria membros, comandas e lancamentos
      // orfaos sob um path que ninguem mais consegue ler. "Excluir" na UI e active:false.
      allow delete: if false;

      // A aresta de autorizacao do sistema: quem esta em qual estabelecimento, com que
      // papel. Toda mutacao passa por callable (F1.7.3) — as rules LEEM este grafo e
      // nunca o escrevem. Isso da um unico ponto de decisao, com auditoria garantida, e
      // deixa este arquivo trivial de auditar: nenhuma escrita aqui pode elevar ninguem.
      match /members/{memberUid} {
        allow read: if canReadTenant(estId);
        allow write: if false;
      }

      // Clientes esportivos — contem PII (CPF, telefone). Vieram da colecao global
      // `sport_clients` em F1.7.2.
      //
      // La a regra era `read: if isSignedIn()`: qualquer conta autenticada lia o CPF e o
      // telefone de TODOS os clientes. Enquanto so existiam ADM, MOD e CLIENT, todos
      // provisionados a mao pelo Console, o risco era contido pelo cadastro fechado.
      //
      // F1.7.3 abre o cadastro — primeiro login vira conta automaticamente. Esta regra e
      // o que impede que abrir o cadastro signifique publicar a base de CPFs, e e por isso
      // que ela precisa estar publicada ANTES daquela fase.
      //
      // `isStaffOf` e nao `canReadTenant`: USER e membro do estabelecimento e mesmo assim
      // nao entra aqui. Frequentar o lugar nao da acesso ao cadastro de quem mais frequenta.
      match /sport_clients/{clientId} {
        allow read: if isStaffOf(estId) || isAdm();
        allow create, update, delete: if isStaffOf(estId) || isAdm();
      }

      // Pre-cadastros por CPF de quem ainda nao tem conta (F1.7.3c).
      //
      // Guarda apenas o CPF mascarado — o numero completo nunca e gravado, e o id do
      // documento e um HMAC com pepper do lado do servidor. Quem le e o staff, para
      // acompanhar o que esta pendente; quem escreve e so a callable.
      match /preregistrations/{cpfHmac} {
        allow read: if isStaffOf(estId) || isAdm();
        allow write: if false;
      }

      // "Vinculos recentes": o aviso de que alguem reclamou um pre-cadastro e entrou.
      //
      // A unica mutacao que o cliente faz e marcar como revisado. Reescrever o resto
      // apagaria a prova de que o vinculo aconteceu, e e justamente essa trilha que
      // permite ao Client desfazer um vinculo indevido.
      match /member_events/{eventId} {
        allow read: if isStaffOf(estId) || isAdm();
        allow create, delete: if false;
        allow update: if isStaffOf(estId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reviewed', 'reviewedBy'])
          && request.resource.data.reviewedBy == request.auth.uid;
      }

      // Trilha de quem mexeu no grafo de membros. So o ADM le; ninguem escreve pelo app.
      match /audit/{entryId} {
        allow read: if isAdm();
        allow write: if false;
      }
    }

    // Alimenta o seletor global: collectionGroup('members').where('uid','==',me).
    //
    // Custa 0 gets e devolve so o proprio vinculo. O match acima nao serve para isso —
    // collection group query so e avaliada contra regras declaradas com wildcard
    // recursivo. Sao dois caminhos de leitura distintos de proposito: pelo path
    // completo, staff do estabelecimento le todos os membros; pelo grupo, cada um
    // alcanca apenas o proprio doc.
    //
    // A condicao e `resource.data.uid`, e NAO `memberUid` (o id do doc), embora os dois
    // sejam sempre iguais. Motivo: numa query o motor precisa decidir antes de ler, e a
    // unica coisa que ele consegue casar com a regra e o filtro `where('uid','==',...)`
    // da propria query. Com a condicao no id do doc a query e negada em bloco, mesmo
    // devolvendo exclusivamente docs do requisitante — foi o caso 63 que mostrou isso.
    //
    // O que sustenta a igualdade entre campo e id e `members` ser `write: if false`:
    // quem escreve e so o Admin SDK dentro das callables, que gravam os dois juntos.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Default deny. kanban e financial ainda sao in-memory; quando migrarem
    // para o Firestore vao bater aqui ate ganharem o proprio bloco `match`.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
